# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# --- Project Specific Ignores ---
# Documentation & prompts (private / temporary docs)
/docs/
docs/

# Local generation & helper scripts
/scripts/
scripts/

# --- Dependencies ---
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Testing ---
/coverage

# --- Next.js Build & Outputs ---
/.next/
/out/
/build

# --- Sensitive Data & Secrets ---
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*credential*
*secret*
.secrets/

# --- Debug & Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs/

# --- Vercel & Deployment ---
.vercel

# --- TypeScript ---
*.tsbuildinfo
next-env.d.ts

# --- IDEs & Editors ---
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# --- Local Databases & Temporary Files ---
*.sqlite
*.sqlite3
*.db
*.bak
*.tmp
*.temp
