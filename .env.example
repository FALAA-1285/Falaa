# ==============================================================================
# FALAH PORTFOLIO & CMS — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development or configure these variables
# in your deployment platform (Vercel, Railway, Docker, etc.).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION BASE URL
# ------------------------------------------------------------------------------
# Canonical URL of the application. Used for metadata, OpenGraph, and absolute links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. ADMIN AUTHENTICATION & SECURITY (STRICT ENFORCEMENT)
# ------------------------------------------------------------------------------
# Email address used to log into the /admin control panel.
ADMIN_EMAIL=admin@falah.dev

# Administrator password.
# WARNING: In production (NODE_ENV=production), passwords shorter than 8 characters
# or missing passwords will be strictly rejected. Never use default passwords!
ADMIN_PASSWORD=change_this_to_a_secure_password_min_8_chars

# Secret key used to sign and verify Admin JWT session tokens (HMAC-SHA256).
# WARNING: In production, this MUST be at least 32 characters long.
# Generate a strong key with: openssl rand -base64 32
ADMIN_JWT_SECRET=production_jwt_secret_must_be_at_least_32_characters_long_2026

# Set to "true" ONLY if all traffic reaches the app through Cloudflare. Otherwise the
# cf-connecting-ip header is client-controlled and would let attackers bypass rate limits.
TRUST_CLOUDFLARE_IP=false

# ------------------------------------------------------------------------------
# 3. POSTGRESQL DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Full connection string URI for PostgreSQL.
# Local Development (Laragon / Local Postgres):
DATABASE_URL=postgresql://postgres@localhost:5432/falaa

# Remote Production (Supabase Transaction Pooler recommended for Serverless):
# DATABASE_URL=postgresql://postgres.[REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require

# Maximum connection pool size (recommended: 3-5 for serverless environments).
PG_MAX_POOL_SIZE=5

# Optional: Disposable database for integration tests (npm test). Tests NEVER use DATABASE_URL.
# TEST_DATABASE_URL=postgresql://postgres@localhost:5432/falaa_test

# Optional: Enable strict TLS certificate validation (set true if providing DB_CA_CERT)
DB_STRICT_SSL=false
# DB_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# ------------------------------------------------------------------------------
# 4. PERSISTENT OBJECT STORAGE (SUPABASE STORAGE)
# ------------------------------------------------------------------------------
# Optional: If configured, media uploads from the admin panel are stored permanently
# in Supabase Object Storage bucket. If omitted, files fallback to public/uploads/
SUPABASE_STORAGE_URL=https://your-project-ref.supabase.co/storage/v1
SUPABASE_STORAGE_BUCKET=portfolio-media
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here
